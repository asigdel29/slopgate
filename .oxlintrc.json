{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["test/fixtures/**"],
  "plugins": ["typescript", "unicorn", "oxc", "node"],
  "rules": {
    "eqeqeq": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    // The analysers run one at a time on purpose: each run is CPU-bound, and
    // batches exist to bound argv size, not to run in parallel.
    "no-await-in-loop": "off"
  }
}
