{
  "name": "slopgate",
  "version": "0.1.0",
  "description": "CI gate for the code-degradation metrics from SlopCodeBench (arXiv:2603.24755): structural erosion and verbosity, for TypeScript, Swift and Kotlin.",
  "keywords": [
    "ast-grep",
    "ci",
    "code-quality",
    "cyclomatic-complexity",
    "static-analysis",
    "technical-debt"
  ],
  "license": "MIT",
  "bin": {
    "slopgate": "./bin/slopgate.ts"
  },
  "files": [
    "bin",
    "src",
    "structural",
    "rules",
    "examples",
    ".claude/skills",
    ".github/instructions"
  ],
  "type": "module",
  "scripts": {
    "check": "bun scripts/check.ts fmt:check lint typecheck knip slop coverage",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "tsc --noEmit",
    "knip": "knip-bun",
    "slop": "bun bin/slopgate.ts --base main",
    "test": "bun test",
    "coverage": "sh scripts/coverage-gate.sh",
    "self": "bun bin/slopgate.ts --report"
  },
  "dependencies": {
    "@ast-grep/cli": "0.40.0",
    "jscpd": "4.0.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "knip": "6.44.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "^6.0.3"
  }
}
