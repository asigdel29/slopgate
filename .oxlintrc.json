{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["test/fixtures/**"],
  "plugins": ["typescript", "unicorn", "oxc", "node"],
  "rules": {
    "eqeqeq": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn"
  }
}
